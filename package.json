{
  "name": "abyss-radio",
  "version": "0.4.0",
  "description": "Abyss Radio - Electron desktop music player (KuGou + NetEase)",
  "main": "desktop/main.cjs",
  "author": "Liu Yongkang",
  "license": "MIT",
  "scripts": {
    "dev": "electron .",
    "build:frontend": "cd ai-radio-v1 && npm run build",
    "start:backend": "cd ai-radio/server && node index.mjs",
    "build:win": "electron-builder --win nsis",
    "build:win:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^42.8.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@meting/core": "^1.6.1",
    "@neteasecloudmusicapienhanced/api": "^4.36.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1"
  },
  "build": {
    "appId": "com.abyss.radio",
    "productName": "AbyssRadio",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "ai-radio/server/**/*",
      "ai-radio-v1/dist/**/*",
      "!ai-radio/server/node_modules/**/*",
      "!ai-radio-v1/node_modules/**/*",
      "!ai-radio/server/.env",
      "!ai-radio/server/abyss.db"
    ],
    "extraMetadata": {
      "main": "desktop/main.cjs"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
